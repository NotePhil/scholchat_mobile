# Development (`npx expo start`, `npm run android` debug builds): local backend (business module, port 8486).
# USB cable: run `adb reverse tcp:8486 tcp:8486` once per connection — works on any Wi-Fi network.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8486/scholchat
# Same Wi-Fi without cable: use this computer's current IP (hostname -I), e.g.
# EXPO_PUBLIC_API_BASE_URL=http://10.237.18.149:8486/scholchat
# To test the dev build against the ONLINE backend instead, comment the line above and use:
# EXPO_PUBLIC_API_BASE_URL=https://scholchat-business-latest.onrender.com/scholchat
