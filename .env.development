# Development (`npx expo start`, `npx expo run:android` debug builds): ONLINE backend.
EXPO_PUBLIC_API_BASE_URL=https://scholchat-business-latest.onrender.com/scholchat
# To use the LOCAL backend instead (business module, port 8486), comment the line above and use:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8486/scholchat
# (USB cable: run `adb reverse tcp:8486 tcp:8486` once per connection.)
