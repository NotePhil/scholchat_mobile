{
  "expo": {
    "name": "ScholChat",
    "slug": "zaq1q",
    "scheme": "scholchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "assets/images/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ScholChat a besoin d'accéder à votre caméra pour les sessions de cours en direct.",
        "NSMicrophoneUsageDescription": "ScholChat a besoin d'accéder à votre microphone pour les sessions de cours en direct."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8C52FF"
      },
      "package": "com.kams2004.schoolchat1",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1efd04c4-cd4c-4e12-bfad-cd3cc447686c"
      }
    },
    "owner": "zaq1qs-team",
    "plugins": [
      "expo-video",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#8C52FF",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ScholChat a besoin d'accéder à votre caméra pour les sessions de cours en direct.",
          "microphonePermission": "ScholChat a besoin d'accéder à votre microphone pour les sessions de cours en direct."
        }
      ]
    ]
  }
}
