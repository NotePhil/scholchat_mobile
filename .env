# Backend API base URL. Expo exposes any EXPO_PUBLIC_* var to client code via process.env.
# PRODUCTION (reachable from anywhere with internet — WiFi or mobile data):
EXPO_PUBLIC_API_BASE_URL=https://scholchat-business-latest.onrender.com/scholchat

# LOCAL DEVELOPMENT (only reachable when the device is on the same LAN as your dev machine):
# EXPO_PUBLIC_API_BASE_URL=http://10.237.18.152:8486/scholchat
