# Backend API base URL. Expo exposes any EXPO_PUBLIC_* var to client code via process.env.
#
# Which file is used (Expo CLI loads, highest priority first: .env.<mode>.local, .env.local,
# .env.<mode>, .env — an already-set environment variable always wins):
#   - `npx expo start` / `npm run android` (development)  -> .env.development (local backend)
#   - `npx expo export`, gradle assembleRelease, EAS builds  -> .env.production (online backend)
#   - EAS cloud builds additionally get the URL from eas.json "env" (same online URL).
# This file is the fallback for every mode: the online backend, so a release build can never
# accidentally point to a developer machine.
#
# NOTE: do not leave a .env.local with a localhost URL around when building a release locally:
# .env.local overrides .env.production (it is gitignored, so EAS cloud builds never see it).
EXPO_PUBLIC_API_BASE_URL=https://scholchat-business-latest.onrender.com/scholchat
